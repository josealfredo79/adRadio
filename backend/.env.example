# =============================================================================
# IaRadio - Variables de Entorno
# Copia este archivo a .env y completa los valores
# =============================================================================

# ===== APP =====
DEBUG=true
APP_VERSION=2.0.0
API_PREFIX=/api/v1

# ===== DATABASE =====
# Neon PostgreSQL (ejemplo)
DATABASE_URL=postgresql+asyncpg://user:pass@host.neon.tech/dbname?ssl=require

# ===== REDIS =====
# Railway Redis (ejemplo)
REDIS_URL=redis://default:password@host.railway.internal:6379

# ===== JWT =====
SECRET_KEY=openssl rand -hex 32 (generar uno nuevo)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== SEGURIDAD =====
# Obligatorio en producción. Hosts permitidos separados por coma.
# Ejemplo: ALLOWED_HOSTS=api.iaradio.online,iaradio.online
ALLOWED_HOSTS=

# ===== EMAIL (SMTP) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
FROM_EMAIL=tu-email@gmail.com

# ===== TWILIO (WhatsApp — legado, en migración a Meta Cloud API) =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Pool de números propios (opcional)
# TWILIO_NUMBER_POOL=+525511111111,+525522222222

# ===== META WHATSAPP CLOUD API =====
# Cifrado en reposo de los tokens de Meta por anunciante (AES-256-GCM).
# Genera con: openssl rand -base64 32   — OBLIGATORIO para conectar WhatsApp.
ENCRYPTION_KEY=

# Handshake GET del webhook de Meta. Genera con: openssl rand -hex 32
# Debe coincidir EXACTO con el "Verify token" configurado en el webhook de la app.
META_WEBHOOK_VERIFY_TOKEN=

# App Secret de la app de Meta (developers.facebook.com → App → Configuración → Básica).
# Valida la firma X-Hub-Signature-256 de cada evento del webhook.
META_APP_SECRET=

# --- Embedded Signup: "Conectar con Meta" en un clic (opcional) ---
# Si META_APP_ID y META_EMBEDDED_SIGNUP_CONFIG_ID están seteados, el wizard
# muestra el botón "Conectar con Meta"; si están vacíos, cae al alta manual
# (pegar WABA ID + Phone Number ID + token). Ver app/api/v1/meta_whatsapp.py.
META_APP_ID=
# App Dashboard → WhatsApp → Embedded Signup → tu configuración.
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Interruptor explícito del botón "Conectar con Meta". Déjalo en false en
# producción (config cargada pero botón oculto) hasta que Meta apruebe
# TP/BSP; ponlo en true solo en staging para probar el flujo end-to-end.
META_EMBEDDED_SIGNUP_ENABLED=false

# Versión de Graph API (debe coincidir con la del SDK JS en frontend/src/lib/fbSdk.ts).
META_GRAPH_API_VERSION=v21.0
# META_GRAPH_BASE_URL=https://graph.facebook.com

# ===== STRIPE (Pagos) =====
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== OPENAI (Whisper transcripciones) =====
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== ANTHROPIC (Claude) =====
# Fallback pagado final de la cadena de proveedores (Groq → OpenRouter →
# Anthropic) — ver app/services/llm_client.py.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== GROQ (Whisper + chat completions gratis) =====
# GROQ_API_KEY se usa para transcripción de audio (Whisper, siempre) y,
# si GROQ_CHAT_MODEL también está configurado, como PRIMER proveedor de
# TODA la generación de texto (bot, campañas, Laboratorio, banners) — cuota
# gratis mucho mayor que OpenRouter (~14,400 req/día vs ~50/día).
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GROQ_CHAT_BASE_URL=https://api.groq.com/openai/v1
# GROQ_CHAT_MODEL=moonshotai/kimi-k2-instruct-0905

# ===== OPENROUTER (segundo proveedor gratis de la cadena) =====
# Opcional. Si se configuran API_KEY y MODEL, se intenta después de Groq
# (o directo, si Groq no está configurado) antes de caer en Anthropic —
# permite usar modelos gratis o baratos (ver openrouter.ai/models) o
# cambiar de proveedor sin tocar código, solo estas variables. Vacío en
# Groq y OpenRouter = comportamiento normal (Anthropic directo).
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Modelo aparte para el juez del Laboratorio (opcional, si se omite usa OPENROUTER_MODEL)
# OPENROUTER_JUDGE_MODEL=

# ===== VOYAGE AI (Embeddings RAG) =====
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOYAGE_EMBEDDING_DELAY_S=22

# ===== GOOGLE CLOUD (TTS + Imagen) =====
GOOGLE_CLOUD_PROJECT=tu-project-id
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","client_email":"...@iam.gserviceaccount.com",...}

# Proveedor de TTS: "google", "fish", o "edge"
GOOGLE_TTS_PROVIDER=google
GOOGLE_TTS_VOICE_NAME=es-ES-Neural2-F

# ===== GOOGLE CALENDAR (Citas) =====
GOOGLE_CALENDAR_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=tu-client-secret

# ===== CLOUDFLARE R2 (Almacenamiento) =====
CF_R2_ACCESS_KEY=tu-access-key
CF_R2_SECRET_KEY=tu-secret-key
CF_R2_BUCKET=adradio-audio
CF_R2_ENDPOINT=https://tu-account.r2.cloudflarestorage.com
CF_R2_PUBLIC_URL=https://tu-account.r2.cloudflarestorage.com/adradio-audio

# ===== FISH AUDIO (TTS Alternativo) =====
FISH_AUDIO_API_KEY=tu-api-key
FISH_AUDIO_VOICE_ID=tu-voice-id

# ===== TWILIO TEMPLATES =====
# SIDs de plantillas aprobadas en Twilio Content API (opcional)
# TWILIO_INVITACION_TEMPLATE_SID=HX5dc3c07019d22ed5b128df45d2ed1b15
# TWILIO_UTILITY_TEMPLATE_SID=HXd5f54a4479517e056e3dc216f95d1067
# TWILIO_ORDER_CONFIRM_BUTTONS_SID=HXef5e2a5ea81bc899605ffd5b18010029
# TWILIO_APPOINTMENT_CONFIRM_BUTTONS_SID=HX9424a04e30e608f3359c77d23a383864

# ===== URLS =====
BASE_URL=https://tu-dominio.up.railway.app
FRONTEND_URL=http://localhost:5173
# FRONTEND_PUBLIC_URL=https://app.iaradio.app (para enlaces externos)
# WIDGET_URL=https://www.iaradio.online (para widget embebible)

# ===== OPCIONALES =====
# SENTRY_DSN=tu-sentry-dsn
# POSTHOG_API_KEY=tu-posthog-key